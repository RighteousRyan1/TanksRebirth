  "BannerColorFlavor": "Zmienia kolor baneru, który pojawia się\nna ekranie pomiędzy misjami.\n Domyślna wartość to (139, 0, 0)",
  "StartingLives": "Życia na start",
  "StartingLivesFlavor": "Z iloma życiami każdy gracz rozpocznie tę kampanię.",
  "HasMajorVictoryTheme": "Używa muzyki Wielkiego Zwycięstwa",
  "HasMajorVictoryThemeFlavor": "Jeżeli tak, na końcu kampanii zostanie odegrana\ninna, bardziej doniosła muzyka.",
  "BrownFlavor": "Łatwy do pokonania, nieruchomy, powoli strzelający przeciwnik.",
  "AshFlavor": "Podobny do brązowego czołgu, ale może powoli się poruszać i strzela nieco częściej.",
  "MarineFlavor": "Powoli poruszający się, pasywny i metodyczny przeciwnik.\nStrzela rakietami zamiast zwykłych pocisków.",
  "YellowFlavor": "Nie nazbyt niebezpieczny. Rozkłada miny i porusza się szybko.",
  "PinkFlavor": "Powolny, ale niezwykle wytrwały i agresywny czołg.\nMoże wystrzelić wiele pocisków naraz.",
  "GreenFlavor": "Wysoce niebezpieczny, lecz nieruchomy czołg.\nWystrzeliwuje wiele rakiet, które mogą odbić się dwa razy.",
  "VioletFlavor": "Szybki, inteligenty czołg, który może wystrzelić\ndo 5 pocisków na raz i rozkładać miny.",
  "WhiteFlavor": "Powoli się poruszający, potężny czołg, który staje się niewidzialny na początku misji, może wystrzelić wiele pocisków naraz oraz rozkładać miny",
  "BlackFlavor": "Czołg który porusza sie szybciej niż gracz, często wystrzeliwuje rakiety, jest agresywny i dobrze unika. Może rozkładać miny.",
  "BronzeFlavor": "Prosty, nieruchomy czołg, który wystrzeliwuje wiele pocisków naraz i celuje dokładnie w przeciwnika.",
  "SilverFlavor": "Zaawansowany i trudny, bardzo ruchomy czołg, który może wystrzelić do 8 pocisków w szybkich seriach i dobrze unika. Może rozkładać miny.",
  "SapphireFlavor": "Śmiertelnie niebezpieczny czołg, który może wystrzelić do 3 rakiet w jednej serii. Może rozkładać miny.",
  "RubyFlavor": "Powolny, ale agresywny czołg, który stale wystrzeliwuje pociski.",
  "CitrineFlavor": "Niesamowicie szybki czołg, który wystrzeliwuje bardzo szybkie pociski w stronę celu. Często rozkłada miny.",
  "AmethystFlavor": "Szybki, bardzo zwinny i dobrze unikający czołg, który wystrzeliwuje serię pocisków w stronę celu. Może rozkładać miny.",
  "EmeraldFlavor": "Neruchomy czołg, który staje się niewidzialny na początku rundy. Wystrzeliwuje wiele podwójnie odbijających się rakiet w stronę celu.",
  "GoldFlavor": "Powolny i ruchliwy czołg, który staje się niewidzialny na początku rundy, i nie zostawia za sobą śladów. Może rozkładać miny.",
  "ObsidianFlavor": "Bardzo szybki, lecz niezbyt inteligentny czołg, który często wystrzeliwuje podwójnie odbijające się, szybkie rakiety. Może rozkładać miny.",
