<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<PublishReadyToRun>false</PublishReadyToRun>
		<TieredCompilation>false</TieredCompilation>
		<AssemblyVersion>1.9.2</AssemblyVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Icon.ico</ApplicationIcon>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<MonoGameContentReference Include="Content\Content.mgcb" />
		<TrimmerRootAssembly Include="Microsoft.Xna.Framework.Content.ContentTypeReader" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Aether.Physics2D.MG" Version="1.6.1" />
		<PackageReference Include="FontStashSharp.MonoGame" Version="1.2.8" />
		<PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
		<PackageReference Include="LiteNetLib" Version="0.9.5.2" />
		<PackageReference Include="Microsoft.CodeAnalysis.Scripting" Version="5.6.0" />
		<PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
		<PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
		<PackageReference Include="NativeFileDialogSharp" Version="0.5.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
		<PackageReference Include="StbVorbisSharp" Version="1.22.4" />
		<PackageReference Include="System.Management" Version="9.0.0" />
		<PackageReference Include="TextCopy" Version="6.1.0" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="DiscordRPC" HintPath="deps\DiscordRPC.dll" />
		<Reference Include="MeltySynth" HintPath="deps\MeltySynth.dll" />
		<Reference Include="Octokit" HintPath="deps\Octokit.dll" />
		<Reference Include="Steamworks.NET" HintPath="deps\Steamworks.NET.dll" />
		<Reference Include="WiimoteLib" HintPath="deps\WiimoteLib.dll" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Icon.ico;Icon.bmp" />
		<EmbeddedResource Include="Icon.ico;Icon.bmp" />
	</ItemGroup>

	<!-- Copied to output directory -->
	<ItemGroup>
		<Content Include="
        Content/Assets/fonts/*.*;
        Content/Assets/music/**/*.*;
        Content/Assets/sounds/**/*.*;
        Content/Assets/fanfares/**/*.*;
        Content/Assets/mainmenu/**/*.*;
        Content/Assets/textures/**/*.*;
        Content/Assets/*.png;
        Content/Assets/models/logo/**/*.png;
        Content/Assets/models/scene/**/*.png;
        Content/Assets/models/rebirth_tanks/**/*.png;
        Content/Assets/models/cosmetics/*.png;
        Content/Assets/cosmetics/**/*.png;
        Content/Assets/christmas/**/*.png;
        Content/Assets/halloween/**/*.png;
		Content/MenuMissions/*.mission"
			CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Localization\credits.txt;Localization\*.json" CopyToOutputDirectory="PreserveNewest" />
		<None Update="Localization\*.loc;steam_api64.dll;steam_appid.txt" CopyToOutputDirectory="Always" />
	</ItemGroup>
</Project>